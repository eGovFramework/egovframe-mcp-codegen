package {{basePackage}}.cmmn.web;

import java.beans.PropertyEditorSupport;
import java.sql.Timestamp;
import java.text.SimpleDateFormat;
import java.util.Date;

import org.springframework.beans.propertyeditors.CustomDateEditor;
import org.springframework.beans.propertyeditors.StringTrimmerEditor;
import org.springframework.web.bind.WebDataBinder;
import org.springframework.web.bind.support.WebBindingInitializer;

/**
 * 폼 입력 공통 바인딩 규칙.
 *
 * VO 의 날짜 필드는 java.sql.Date / java.sql.Timestamp 이므로 두 타입에 전용 편집기를 등록한다.
 * java.util.Date 용 CustomDateEditor 만 두면 Timestamp 필드에도 그 편집기가 적용되어
 * java.util.Date 를 돌려주다 타입 불일치로 바인딩이 실패하고, 수정 폼이 그대로 제출하는
 * 빈 날짜 입력란도 allowEmpty=false 에 걸려 거부된다.
 * - Date: 'yyyy-MM-dd' 만 허용. 빈 문자열은 null.
 * - Timestamp: 'yyyy-MM-dd' 만 들어오면 ' 00:00:00' 보강 후 Timestamp.valueOf().
 */
public class EgovBindingInitializer implements WebBindingInitializer {
	@Override
	public void initBinder(WebDataBinder binder) {
		SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd");
		dateFormat.setLenient(false);
		binder.registerCustomEditor(Date.class, new CustomDateEditor(dateFormat, true));
		binder.registerCustomEditor(java.sql.Date.class, new PropertyEditorSupport() {
			@Override
			public void setAsText(String text) throws IllegalArgumentException {
				if (text == null || text.trim().isEmpty()) { setValue(null); return; }
				setValue(java.sql.Date.valueOf(text.trim()));
			}
		});
		binder.registerCustomEditor(Timestamp.class, new PropertyEditorSupport() {
			@Override
			public void setAsText(String text) throws IllegalArgumentException {
				if (text == null || text.trim().isEmpty()) { setValue(null); return; }
				String s = text.trim();
				if (s.length() == 10 && s.charAt(4) == '-' && s.charAt(7) == '-') s = s + " 00:00:00";
				setValue(Timestamp.valueOf(s));
			}
		});
		binder.registerCustomEditor(String.class, new StringTrimmerEditor(false));
	}
}
