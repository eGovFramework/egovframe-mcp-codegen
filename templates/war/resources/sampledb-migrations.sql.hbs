-- ============================================================================
-- {{dialect}} 운영 DB 용 DDL — 엔티티 '{{entityName}}' 마이그레이션
-- ============================================================================
-- 본 파일은 spring.profiles.active 를 hsql 외의 값({{dialect}}) 으로 변경했을 때
-- 적용할 DDL 입니다. 기본 HSQL 프로파일에서는 사용되지 않습니다.
--
-- 적용 방법:
--   - 운영 DB 에 직접 실행하거나 Flyway/Liquibase 등 마이그레이션 도구에 투입.
{{#if isPrimaryEntity}}
--   - IDS 테이블은 첫 엔티티의 마이그레이션에 포함되어 있습니다 (eGovFrame 의
--     EgovTableIdGnrService 가 사용하는 채번 테이블 — 프로젝트당 1회만 생성).
{{else}}
--   - IDS 테이블은 첫 엔티티 마이그레이션에서 이미 생성되었다고 가정합니다.
--     여기서는 새 엔티티의 채번 row INSERT 만 추가합니다.
{{/if}}
-- ============================================================================

{{#if (eq dialect "oracle")}}
CREATE TABLE {{tableName}} (
{{#each attributes}}
	{{columnName}}	{{{dialectType dataType maxLength "oracle" scale}}}{{#if defaultValue}} DEFAULT {{{defaultValue}}}{{/if}}{{#if isPrimaryKey}} NOT NULL{{#unless ../hasCompositePk}} PRIMARY KEY{{/unless}}{{else}}{{#if isNotNull}} NOT NULL{{/if}}{{/if}}{{#if @last}}{{#if ../hasTrailingTableClauses}},{{/if}}{{else}},{{/if}}
{{/each}}
{{#if hasCompositePk}}
	PRIMARY KEY ({{#each pkAttributes}}{{columnName}}{{#unless @last}}, {{/unless}}{{/each}}){{#if fkAttributes.length}},{{/if}}
{{/if}}
{{#each fkAttributes}}
	CONSTRAINT FK_{{../tableName}}_{{columnName}} FOREIGN KEY ({{columnName}}) REFERENCES {{fk.targetTable}}({{fk.targetColumn}}){{#unless @last}},{{/unless}}
{{/each}}
);
{{#if isPrimaryEntity}}

CREATE TABLE IDS (
	TABLE_NAME	VARCHAR2(16) NOT NULL PRIMARY KEY,
	NEXT_ID		NUMBER(30) NOT NULL
);
{{/if}}
INSERT INTO IDS VALUES('{{entityNameUpper}}', 1);
