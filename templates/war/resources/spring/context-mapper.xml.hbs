<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

	<!--
		MyBatis 통합 설정.

		다중 엔티티 환경을 기본으로 가정한다:
		  - mapperLocations 는 'classpath*:' + '**' 와일드카드로 모든 entityModule 하위 매퍼 XML 을 한 번에 로드한다.
		  - typeAliasesPackage 는 base 패키지 하위 모든 VO 클래스를 자동 등록한다.
		    (예: BoardVO → boardVO, MemberDefaultVO → memberDefaultVO)
		    base 패키지 밖의 별칭(egovMap) 만 typeAliases 로 별도 등록한다.
		  - MapperConfigurer 는 base 패키지 전체를 스캔하되 @Mapper 가 붙은 인터페이스만 빈으로 등록한다.

		따라서 egov_add_entity 가 추가하는 엔티티는 이 파일을 손대지 않아도 즉시 인식된다.
	-->

	<bean id="sqlSession" class="org.mybatis.spring.SqlSessionFactoryBean">
		<property name="dataSource" ref="dataSource" />
		<property name="mapperLocations" value="classpath*:/egovframework/sqlmap/**/mappers/*.xml" />
		<property name="typeAliasesPackage" value="{{basePackage}}" />
		<property name="typeAliases" value="org.egovframe.rte.psl.dataaccess.util.EgovMap" />
	</bean>

	<bean class="org.egovframe.rte.psl.dataaccess.mapper.MapperConfigurer">
		<property name="basePackage" value="{{basePackage}}" />
		<property name="annotationClass" value="org.egovframe.rte.psl.dataaccess.mapper.Mapper" />
	</bean>
</beans>
