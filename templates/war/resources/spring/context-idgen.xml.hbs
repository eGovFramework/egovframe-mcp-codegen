<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

	<!--
		엔티티별 ID 생성기 설정. 두 빈 이름 모두 엔티티명 prefix 를 포함하므로
		한 프로젝트에 여러 엔티티가 있어도 빈 이름이 충돌하지 않는다.
		egov_add_entity 가 새 엔티티를 추가할 때 같은 패턴의 새 파일을 만든다.
		web.xml 의 contextConfigLocation 이 classpath*:egovframework/spring/context-*.xml
		와일드카드 스캔이므로 별도 등록이 필요 없다.
	-->
	<bean name="egov{{entityName}}IdGnrStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
		<property name="prefix" value="{{idPrefix}}" />
		<property name="cipers" value="5" />
		<property name="fillChar" value="0" />
	</bean>

	<bean name="egov{{entityName}}IdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
		<property name="dataSource" ref="dataSource" />
		<property name="strategy" ref="egov{{entityName}}IdGnrStrategy" />
		<property name="blockSize" value="10" />
		<property name="table" value="IDS" />
		<property name="tableName" value="{{entityNameUpper}}" />
	</bean>
</beans>
