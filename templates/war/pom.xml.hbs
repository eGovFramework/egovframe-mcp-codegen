<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>{{groupId}}</groupId>
	<artifactId>{{artifactId}}</artifactId>
	<packaging>war</packaging>
	<version>1.0.0</version>
	<name>{{projectName}}</name>
	<description>{{description}}</description>
	<url>http://www.egovframe.go.kr</url>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<!-- 공식 eGovFrame 웹(Spring Boot 미사용) 부모: 실행환경 루트 BOM 을 import 하고, 루트 BOM 이 관리하지 않는
	     Servlet/JSP API·JSON-B·JUnit 등과 compiler/war/surefire 플러그인 버전을 관리한다 (java.version=1.8).
	     실행환경 모듈과 아래 의존성의 버전은 모두 부모가 관리하므로 이 pom 에서 다시 선언하지 않는다. -->
	<parent>
		<groupId>{{stack.starterParentGroupId}}</groupId>
		<artifactId>{{stack.starterParentArtifactId}}</artifactId>
		<version>{{stack.starterParentVersion}}</version>
	</parent>

	<repositories>
		<repository>
			<id>mvn2s</id>
			<url>https://repo1.maven.org/maven2/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
		<repository>
			<id>egovframe</id>
			<url>https://maven.egovframe.go.kr/maven/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- eGovFrame Runtime (버전은 부모가 import 한 실행환경 루트 BOM 이 관리) -->
		<dependency>
			<groupId>org.egovframe.rte</groupId>
			<artifactId>org.egovframe.rte.ptl.mvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.egovframe.rte</groupId>
			<artifactId>org.egovframe.rte.psl.dataaccess</artifactId>
		</dependency>
		<dependency>
			<groupId>org.egovframe.rte</groupId>
			<artifactId>org.egovframe.rte.fdl.idgnr</artifactId>
		</dependency>
		<dependency>
			<groupId>org.egovframe.rte</groupId>
			<artifactId>org.egovframe.rte.fdl.property</artifactId>
		</dependency>

		<!-- Servlet 3.1 / JSTL 1.2 (컨테이너 제공) -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.servlet.jsp.jstl</groupId>
			<artifactId>jstl-api</artifactId>
			<exclusions>
				<!-- jstl-api 가 전이하는 구버전 Servlet/JSP API 제외 (컨테이너가 제공) -->
				<exclusion>
					<groupId>javax.servlet</groupId>
					<artifactId>servlet-api</artifactId>
				</exclusion>
				<exclusion>
					<groupId>javax.servlet.jsp</groupId>
					<artifactId>jsp-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.taglibs</groupId>
			<artifactId>taglibs-standard-impl</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ANTLR -->
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr</artifactId>
		</dependency>

		<!-- ==== DataSource (HSQL 기본, 외부 DB 전환 시 아래 가이드 참고) ==== -->
		<!-- 내장 HSQLDB: 실행환경 BOM 이 2.7.x 를 jdk8 classifier 와 함께 관리한다 (기본 JAR 은 Java 11 용). classifier 만 적는다 -->
		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<classifier>jdk8</classifier>
		</dependency>
		<!-- 외부 DB(BasicDataSource) 사용 시 필요 — 기본 활성. 버전은 부모가 관리 -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-dbcp2</artifactId>
			<exclusions>
				<!-- Jakarta EE 8 아티팩트 제외 (javax.transaction 은 실행환경이 전이하는 javaee-api 로 제공) -->
				<exclusion>
					<groupId>jakarta.transaction</groupId>
					<artifactId>jakarta.transaction-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ==== JDBC 드라이버 가이드 ====
		     사용할 DB 의 의존성 블록을 주석 해제하세요.
		     globals.properties 와 context-datasource.xml 함께 변경 필요.
		     MySQL / MariaDB / PostgreSQL 드라이버 버전은 부모가 관리하므로 <version> 을 쓰지 않습니다.

		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc8</artifactId>
			<version>23.4.0.24.05</version>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>

		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		Tibero / Altibase / Cubrid / Goldilocks 드라이버는 Maven Central 에
		배포되지 않을 수 있어 벤더 사이트에서 직접 받아 system scope 또는
		사내 Nexus 등 사설 저장소를 통해 추가하시기 바랍니다.
		==== -->

		<!-- JSON-B / JSON-P (Spring MVC 가 classpath 의 javaee-api 를 보고 요구) -->
		<dependency>
			<groupId>org.eclipse</groupId>
			<artifactId>yasson</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish</groupId>
			<artifactId>javax.json</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- compiler(source/target 1.8, UTF-8) / war 플러그인 버전과 설정은 부모의 pluginManagement 가 관리한다 -->
</project>
