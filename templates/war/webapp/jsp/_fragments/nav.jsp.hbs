<%--
	엔티티 간 메뉴 네비게이션 fragment (eGovFrame 4.3 WAR / JSP).
	이 파일은 egov_add_entity 도구가 단일 출처로 관리한다.
--%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://www.springframework.org/tags" prefix="spring" %>
<style>
	.egov-entity-nav { margin: 0 auto 1.5rem auto; padding: 0; max-width: 980px; border-bottom: 1px solid #d8e5fd; }
	.egov-entity-nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem; }
	.egov-entity-nav-list > li { margin: 0; padding: 0; }
	.egov-entity-nav-list > li > a { display: inline-block; padding: 0.5rem 0.95rem; color: #083891; font-weight: 500; text-decoration: none; border-radius: 5px 5px 0 0; }
	.egov-entity-nav-list > li > a:hover { background:#ecf2fe; color:#052561; }
	.egov-entity-nav-list > li > a.is-active { background:#256ef4; color:#fff; font-weight:600; }
</style>
<div class="egov-entity-nav" role="navigation" aria-label="entity navigation">
	<ul class="egov-entity-nav-list">
{{#each entities}}
		<li>
			<a href="<c:url value='/egov{{entityName}}List.do'/>"
			   class="${pageContext.request.requestURI.startsWith(pageContext.request.contextPath += '/egov{{entityName}}List') ? 'is-active' : ''}">
				<spring:message code="nav.{{entityNameLower}}" />
			</a>
		</li>
{{/each}}
	</ul>
</div>
