<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form-validation PUBLIC
	"-//Apache Software Foundation//DTD Commons Validator Rules Configuration 1.2.0//EN"
	"http://commons.apache.org/dtds/validator_1_2_0.dtd">
<!--
	commons-validator DTD: formset 은 form 을 1개 이상, form 은 field 를 1개 이상 가져야 한다.
	필수(NOT NULL) 문자열 컬럼이 없는 엔티티는 form 을 만들지 않으며, 등록 화면은 validate{Entity}VO()
	가 없으면 클라이언트 검증 없이 제출한다 (서버 검증은 그대로 동작).
-->
<form-validation>
{{#if hasRequiredStringAttr}}
	<formset>
		<form name="{{voName}}">
{{#each requiredStringAttributes}}
			<field property="{{ccName}}" depends="required">
				<arg key="title.{{../entityNameLower}}.{{ccName}}" position="0" />
			</field>
{{/each}}
		</form>
	</formset>
{{/if}}
</form-validation>
