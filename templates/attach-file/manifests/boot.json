{
  "$comment": "eGovFrame Boot(5.0/4.3 공용) 첨부파일 인프라 매니페스트. 호출자: egov_add_attach_file_infrastructure 도구. 모든 항목 scope=framework (프로젝트당 1회). mode 별 의미는 manifestLoader.ts 의 ManifestMode 주석 참조. 변수: basePackage, basePackagePath, idGnrPrefix, idGnrCipers, fileStorePath, dialect(expandDialects).",
  "name": "attach-file-boot",
  "files": [
    { "template": "attach-file/boot/java/EgovFileMngService.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/service/EgovFileMngService.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/FileVO.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/service/FileVO.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/EgovFileMngUtil.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/service/EgovFileMngUtil.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/EgovFileMngServiceImpl.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/service/impl/EgovFileMngServiceImpl.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/FileManageMapper.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/service/impl/FileManageMapper.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/EgovFileDownloadController.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/web/EgovFileDownloadController.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/EgovConfigAttachFile.hbs",
      "output":   "src/main/java/{{basePackagePath}}/config/EgovConfigAttachFile.java",
      "mode": "create" },
    { "template": "attach-file/boot/java/EgovFileUploadExceptionAdvice.hbs",
      "output":   "src/main/java/{{basePackagePath}}/cmm/web/EgovFileUploadExceptionAdvice.java",
      "mode": "create" },
    { "template": "attach-file/boot/mapper/EgovFileMng_SQL.xml.hbs",
      "output":   "src/main/resources/egovframework/sqlmap/cmm/mappers/EgovFileMng_SQL.xml",
      "mode": "create" },
    { "template": "attach-file/boot/ddl/attach-file.sql.hbs",
      "output":   "src/main/resources/db/migrations/{{dialect}}/attach-file.sql",
      "expandDialects": true,
      "mode": "create" },
    { "template": "attach-file/boot/thymeleaf/_fragments/alertMessages.html.hbs",
      "output":   "src/main/resources/templates/thymeleaf/_fragments/alertMessages.html",
      "mode": "create" },
    { "template": "attach-file/boot/thymeleaf/cmm/uploadError.html.hbs",
      "output":   "src/main/resources/templates/thymeleaf/cmm/uploadError.html",
      "mode": "create" },
    { "template": "attach-file/boot/properties/attach-file.properties.hbs",
      "output":   "src/main/resources/application.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/application.properties" } },
    { "template": "attach-file/boot/properties/attach-file-multipart.properties.hbs",
      "output":   "src/main/resources/application.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/application.properties" } },
    { "template": "attach-file/boot/properties/attach-file-tomcat.properties.hbs",
      "output":   "src/main/resources/application.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/application.properties" } },
    { "template": "attach-file/boot/properties/attach-file-security.properties.hbs",
      "output":   "src/main/resources/application.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/application.properties" } },
    { "template": "attach-file/boot/properties/attach-file-globals.properties.hbs",
      "output":   "src/main/resources/egovframework/egovProps/globals.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/egovframework/egovProps/globals.properties" } },
    { "template": "attach-file/boot/messages/attach-file-message-common.properties.hbs",
      "output":   "src/main/resources/egovframework/message/message-common.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/egovframework/message/message-common.properties" } },
    { "template": "attach-file/boot/messages/attach-file-message-common.properties.hbs",
      "output":   "src/main/resources/egovframework/message/message-common_ko.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/egovframework/message/message-common_ko.properties" } },
    { "template": "attach-file/boot/messages/attach-file-message-common_en.properties.hbs",
      "output":   "src/main/resources/egovframework/message/message-common_en.properties",
      "mode": "append-idempotent",
      "appendTarget": { "glob": "src/main/resources/egovframework/message/message-common_en.properties" } }
  ]
}
