{
  "$comment": "eGovFrame scaffold 스택 호환성 매트릭스. egov_scaffold_project 가 (projectType, stackVersion) 을 키로 이 매트릭스를 조회해 컨텍스트와 템플릿에 주입한다. 새 스택 추가 시 stacks 키와 selection 매핑을 함께 갱신할 것.",
  "version": 1,
  "stacks": {
    "boot50": {
      "projectType": "boot",
      "stackVersion": "5.1",
      "egovframe": "5.1.0",
      "springBoot": "3.5.16",
      "spring": null,
      "java": "17",
      "jakarta": true,
      "rteVersion": null,
      "starterParentGroupId": "org.egovframe.boot",
      "starterParentArtifactId": "egovframe-boot-starter-parent",
      "starterParentVersion": "5.1.0",
      "frameworkLabel": "eGovFrame Boot 5.1.0",
      "staticAssets": "static50",
      "manifest": "manifests/boot50.json",
      "addEntityMigration": "boot50/resources/add-entity-tables.sql.hbs",
      "addEntityMessages": {
        "defaultLocale": "boot50/message/message-entity-keys.properties.hbs",
        "en": "boot50/message/message-entity-keys_en.properties.hbs"
      },
      "navFragment": {
        "template": "boot50/thymeleaf/_fragments/nav.html.hbs",
        "output": "src/main/resources/templates/thymeleaf/_fragments/nav.html"
      },
      "queryView": [
        { "template": "boot50/java/queryView/QueryViewDefaultVO.hbs", "output": "src/main/java/{{packagePath}}/{{viewName}}DefaultVO.java" },
        { "template": "boot50/java/queryView/QueryViewVO.hbs", "output": "src/main/java/{{packagePath}}/{{viewName}}VO.java" },
        { "template": "boot50/java/queryView/QueryViewMapper.hbs", "output": "src/main/java/{{packagePath}}/impl/{{viewName}}Mapper.java" },
        { "template": "boot50/java/queryView/EgovQueryViewService.hbs", "output": "src/main/java/{{packagePath}}/Egov{{viewName}}Service.java" },
        { "template": "boot50/java/queryView/EgovQueryViewServiceImpl.hbs", "output": "src/main/java/{{packagePath}}/impl/Egov{{viewName}}ServiceImpl.java" },
        { "template": "boot50/java/queryView/EgovQueryViewController.hbs", "output": "src/main/java/{{basePackagePath}}/{{entityModule}}/web/Egov{{viewName}}Controller.java" },
        { "template": "boot50/resources/queryView-sql.xml.hbs", "output": "src/main/resources/egovframework/sqlmap/{{entityModule}}/mappers/Egov{{viewName}}_{{viewName}}_SQL.xml" },
        { "template": "boot50/thymeleaf/queryViewList.html.hbs", "output": "src/main/resources/templates/thymeleaf/{{entityModule}}/egov{{viewName}}List.html" }
      ]
    },
    "boot43": {
