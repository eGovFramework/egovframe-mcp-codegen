      "queryView": [
        { "template": "war/java/queryView/QueryViewDefaultVO.hbs", "output": "src/main/java/{{packagePath}}/{{viewName}}DefaultVO.java" },
        { "template": "war/java/queryView/QueryViewVO.hbs", "output": "src/main/java/{{packagePath}}/{{viewName}}VO.java" },
        { "template": "war/java/queryView/QueryViewMapper.hbs", "output": "src/main/java/{{packagePath}}/impl/{{viewName}}Mapper.java" },
        { "template": "war/java/queryView/EgovQueryViewService.hbs", "output": "src/main/java/{{packagePath}}/Egov{{viewName}}Service.java" },
        { "template": "war/java/queryView/EgovQueryViewServiceImpl.hbs", "output": "src/main/java/{{packagePath}}/impl/Egov{{viewName}}ServiceImpl.java" },
        { "template": "war/java/queryView/EgovQueryViewController.hbs", "output": "src/main/java/{{basePackagePath}}/{{entityModule}}/web/Egov{{viewName}}Controller.java" },
