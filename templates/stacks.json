  "selection": [
    { "projectType": "boot", "stackVersion": "5.1", "stack": "boot50" },
    { "projectType": "boot", "stackVersion": "4.3", "stack": "boot43" },
    { "projectType": "war", "stackVersion": "4.3", "stack": "war43" }
