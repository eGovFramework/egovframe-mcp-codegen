      "java": "1.8",
      "jakarta": false,
      "rteVersion": "4.3.2",
      "starterParentGroupId": "org.egovframe.web",
      "starterParentArtifactId": "org.egovframe.web.config.parent",
      "starterParentVersion": "4.3.2",
      "frameworkLabel": "Spring 5.3.39-egov.2",
      "staticAssets": "static",
      "manifest": "manifests/war43.json",
      "addEntityMigration": "war/resources/add-entity-tables.sql.hbs",
      "addEntityMessages": {
        "defaultLocale": "war/message/message-entity-keys.properties.hbs",
        "en": "war/message/message-entity-keys_en.properties.hbs"
      },
      "navFragment": {
