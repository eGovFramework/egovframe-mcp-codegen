        { "template": "boot/java/queryView/QueryViewVO.hbs", "output": "src/main/java/{{packagePath}}/{{viewName}}VO.java" },
        { "template": "boot/java/queryView/QueryViewMapper.hbs", "output": "src/main/java/{{packagePath}}/impl/{{viewName}}Mapper.java" },
        { "template": "boot/java/queryView/EgovQueryViewService.hbs", "output": "src/main/java/{{packagePath}}/Egov{{viewName}}Service.java" },
        { "template": "boot/java/queryView/EgovQueryViewServiceImpl.hbs", "output": "src/main/java/{{packagePath}}/impl/Egov{{viewName}}ServiceImpl.java" },
        { "template": "boot/java/queryView/EgovQueryViewController.hbs", "output": "src/main/java/{{basePackagePath}}/{{entityModule}}/web/Egov{{viewName}}Controller.java" },
        { "template": "boot/resources/queryView-sql.xml.hbs", "output": "src/main/resources/egovframework/sqlmap/{{entityModule}}/mappers/Egov{{viewName}}_{{viewName}}_SQL.xml" },
