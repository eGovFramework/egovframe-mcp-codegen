		if (files != null && !files.isEmpty()) {
			java.util.List<FileVO> fvoList = fileUtil.parseFileInf(files, "{{entityNameUpper}}_", 0, "", "");
			{{attachmentFieldName}} = fileMngService.insertFileInfs(fvoList);
		}
		{{entityNameLower}}VO.set{{attachmentFieldNamePascal}}({{attachmentFieldName}});
{{/if}}
		{{entityNameLower}}Service.insert{{entityName}}({{entityNameLower}}VO);
		status.setComplete();
		return "redirect:/egov{{entityName}}List.do";
