	@PostMapping("/update{{entityName}}.do")
	public String update{{entityName}}({{#if withAttachment}}final MultipartHttpServletRequest multiRequest, {{/if}}@Valid @ModelAttribute("{{entityNameLower}}VO") {{entityName}}VO {{entityNameLower}}VO, BindingResult bindingResult,
			Model model, RedirectAttributes redirectAttributes, SessionStatus status) throws Exception {
		if (bindingResult.hasErrors()) {
			model.addAttribute("{{entityNameLower}}VO", {{entityNameLower}}VO);
{{#if hasFk}}
			populate{{entityName}}ReferenceLists(model);
{{/if}}
			return "{{entityModule}}/egov{{entityName}}Register";
		}
{{#if withAttachment}}
		// 첨부파일 update — 신규 그룹이면 채번, 기존 그룹이면 다음 FILE_SN 부터 append.
		// 그룹 키는 요청 값을 신뢰하지 않고 DB 에 저장된 값에서 읽는다 (다른 레코드의 첨부 그룹 탈취 방지).
		{{entityName}}VO stored = {{entityNameLower}}Service.select{{entityName}}({{entityNameLower}}VO);
		String {{attachmentFieldName}} = stored.get{{attachmentFieldNamePascal}}();
		final java.util.List<MultipartFile> files = multiRequest.getFiles("file_1");
		if (files != null && !files.isEmpty()) {
			if ({{attachmentFieldName}} == null || {{attachmentFieldName}}.isBlank()) {
				// (A) 첨부 그룹이 아직 없음 → 신규 채번
				java.util.List<FileVO> fvoList = fileUtil.parseFileInf(files, "{{entityNameUpper}}_", 0, "", "");
				{{attachmentFieldName}} = fileMngService.insertFileInfs(fvoList);
				{{entityNameLower}}VO.set{{attachmentFieldNamePascal}}({{attachmentFieldName}});
			} else {
				// (B) 기존 그룹에 추가 — getMaxFileSN 으로 다음 FILE_SN 부터 (중복 PK 방지)
				FileVO key = new FileVO();
				key.setAtchFileId({{attachmentFieldName}});
				int cnt = fileMngService.getMaxFileSN(key);
				java.util.List<FileVO> fvoList = fileUtil.parseFileInf(files, "{{entityNameUpper}}_", cnt, {{attachmentFieldName}}, "");
				fileMngService.updateFileInfs(fvoList);
			}
		}
		// 요청에 실려 온 값을 덮어써 DB 값(또는 새로 채번한 값)만 저장한다.
		{{entityNameLower}}VO.set{{attachmentFieldNamePascal}}({{attachmentFieldName}});
{{/if}}
		{{entityNameLower}}Service.update{{entityName}}({{entityNameLower}}VO);
		status.setComplete();
		redirectAttributes.addAttribute("searchCondition", {{entityNameLower}}VO.getSearchCondition());
		redirectAttributes.addAttribute("searchKeyword", {{entityNameLower}}VO.getSearchKeyword());
		redirectAttributes.addAttribute("pageIndex", {{entityNameLower}}VO.getPageIndex());
		return "redirect:/egov{{entityName}}List.do";
	}

