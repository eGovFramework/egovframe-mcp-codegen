<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- CSRF meta — AJAX(fetch) 요청 헤더용. Spring Security 미사용 프로젝트에서는 렌더링되지 않는다. -->
    <meta th:if="${_csrf != null}" name="_csrf" th:content="${_csrf.token}">
    <meta th:if="${_csrf != null}" name="_csrf_header" th:content="${_csrf.headerName}">
    <title th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="|{{entityName}} #{button.modify}|"></title>
    <title th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="|{{entityName}} #{button.create}|"></title>

	<link rel="stylesheet" type="text/css" th:href="@{/css/component/output.css}">
	<link rel="stylesheet" type="text/css" th:href="@{/css/egovframe.css}">
{{#if hasDateAttr}}
	<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
{{/if}}
	<script th:inline="javascript" th:src="@{/js/jquery.min.js}"></script>
	<script th:inline="javascript" th:src="@{/js/component/ui-script.js}" defer></script>
	<script th:inline="javascript" th:src="@{/js/egovframework/common.js}" defer></script>
	<script th:inline="javascript" th:src="@{/js/egovframework/EgovValidation.js}" defer></script>
{{#if hasDateAttr}}
	<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/ko.js"></script>
{{/if}}

    <script th:inline="javascript" defer>
{{#if hasDateAttr}}
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof flatpickr === 'function') {
                flatpickr('.flatpickr-date', {
                    dateFormat: 'Y-m-d',
                    allowInput: true,
                    locale: (typeof flatpickr.l10ns !== 'undefined' && flatpickr.l10ns.ko) ? 'ko' : 'default'
                });
            }
        });

{{/if}}
        function validate{{entityName}}VO(form) {
            const rules = {
{{#if idGenerationManual}}
{{#each pkAttributes}}
{{#if (eq javaType "java.lang.String")}}
                {{ccName}}: {
                    label: {{concat "[[#{title." ../entityNameLower "." ccName "}]]"}},
                    rules: { required: true{{#if maxLength}}, maxlength: {{maxLength}}{{/if}} }
                },
{{/if}}
{{/each}}
{{/if}}
{{#each nonPkAttributes}}
{{#if (eq javaType "java.lang.String")}}
                {{ccName}}: {
                    label: {{concat "[[#{title." ../entityNameLower "." ccName "}]]"}},
                    rules: { required: true{{#if maxLength}}, maxlength: {{maxLength}}{{/if}} }
                },
{{/if}}
{{/each}}
            };
            return EgovValidation.validateForm(form, rules);
        }

    	// GET 제출 전에는 CSRF hidden 필드를 disabled 처리한다 — disabled 컨트롤은
    	// 직렬화되지 않으므로 토큰이 URL 쿼리스트링(브라우저 이력·로그)에 유출되지 않는다.
    	function {{entityNameLower}}List() {
            $('#csrfField').prop('disabled', true);
            $('#detailForm').attr('method', 'get').attr('action', contextPath + '/egov{{entityName}}List.do').submit();
        }

        function {{entityNameLower}}Add() {
            if (confirm(/*[[#{add.confirm}]]*/ '\uB4F1\uB85D\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?')) {
                let frm = document.detailForm;
                if (!validate{{entityName}}VO(frm)) {
					return;
				} else {
					$('#csrfField').prop('disabled', false);
					$('#detailForm').attr('method', 'post').attr('action', contextPath + '/add{{entityName}}.do').submit();
				}
            }
        }

        function {{entityNameLower}}Update() {
            if (confirm(/*[[#{modify.confirm}]]*/ '\uC218\uC815\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?')) {
            	let frm = document.detailForm;
                if (!validate{{entityName}}VO(frm)) {
					return;
				} else {
            		$('#csrfField').prop('disabled', false);
            		$('#detailForm').attr('method', 'post').attr('action', contextPath + '/update{{entityName}}.do').submit();
				}
			}
        }

        function {{entityNameLower}}Delete() {
            if (confirm(/*[[#{delete.confirm}]]*/ '\uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?')) {
                $('#csrfField').prop('disabled', false);
                $('#detailForm').attr('method', 'post').attr('action', contextPath + '/delete{{entityName}}.do').submit();
            }
        }

        function {{entityNameLower}}Reset() {
            $('form').each(function() {
                this.reset();
            });
        }
{{#if withAttachment}}

        /**
         * 첨부 그룹의 단일 파일을 삭제한다. 도메인 행은 유지.
         * 삭제 성공 시 location.reload 로 현재 수정 화면을 새로고침 — 목록이 갱신되어
         * 삭제된 파일이 자동으로 사라진다.
         *
         * 호출자: 각 첨부 li 의 [삭제] 버튼. data-* 속성으로 atchFileId/fileSn 전달.
         */
        function {{entityNameLower}}DeleteAttach(btn) {
            if (!confirm(/*[[#{delete.confirm}]]*/ '삭제하시겠습니까?')) return;
            const atchFileId = btn.getAttribute('data-atch-file-id');
            const fileSn = btn.getAttribute('data-file-sn');
            const body = 'atchFileId=' + encodeURIComponent(atchFileId) + '&fileSn=' + encodeURIComponent(fileSn);
            const headers = { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' };
            // CSRF 보호 활성 시 meta 태그의 토큰을 요청 헤더로 전송 (미활성이면 meta 가 없다)
            const csrfHeaderMeta = document.querySelector('meta[name="_csrf_header"]');
            const csrfTokenMeta = document.querySelector('meta[name="_csrf"]');
            if (csrfHeaderMeta && csrfTokenMeta) {
                headers[csrfHeaderMeta.content] = csrfTokenMeta.content;
            }
            fetch(contextPath + '/delete{{entityName}}AttachFile.do', {
                method: 'POST',
                headers: headers,
                body: body,
                credentials: 'same-origin'
            }).then(function(res) {
                if (res.ok) {
                    location.reload();
                } else {
                    alert('첨부파일 삭제에 실패했습니다 (status=' + res.status + ').');
                }
            }).catch(function(err) {
                alert('첨부파일 삭제 중 오류: ' + err);
            });
        }
{{/if}}
    </script>
</head>

<body>
<div id="container" class="inner">

	<h2 class="heading-large">
	    <span th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="#{button.modify}"></span>
	    <span th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="#{button.create}"></span>
	</h2>

	<form id="detailForm" name="detailForm" th:object="{{{thExpr voName}}}"{{#if withAttachment}} enctype="multipart/form-data"{{/if}}>
	<input type="hidden" th:id="searchCondition" th:name="searchCondition" th:value="{{{thExpr voName ".searchCondition"}}}" />
	<input type="hidden" th:id="searchKeyword" th:name="searchKeyword" th:value="{{{thExpr voName ".searchKeyword"}}}" />
	<input type="hidden" th:id="pageIndex" th:name="pageIndex" th:value="{{{thExpr voName ".pageIndex"}}}" />
	<!-- 등록/수정/삭제가 POST submit 이므로 CSRF 토큰을 함께 전송한다.
	     GET 제출(목록 복귀) 전에는 스크립트가 disabled 처리해 URL 유출을 막는다. -->
	<input type="hidden" id="csrfField" th:if="${_csrf != null}" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
{{#if withAttachment}}
	<!-- 첨부파일 그룹 키 (update 시 기존 값 보존). 신규 등록이면 빈 값 — Controller 에서 채번. -->
	<input type="hidden" id="{{attachmentFieldName}}" name="{{attachmentFieldName}}" th:value="{{{thExpr voName "." attachmentFieldName}}}" />
{{/if}}

		<div class="conts-wrap">
	        <div class="fieldset input-form">
{{#each attributes}}
{{#if isPrimaryKey}}
{{#if ../idGenerationManual}}
                <!-- idGeneration='manual' — 사용자가 직접 입력. 수정 진입 시(PK 값 존재) 는 readonly. -->
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"> <span class="required">*</span></label>
                    </div>
                    <div class="form-conts">
                        <input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input" maxlength="{{#if maxLength}}{{maxLength}}{{else}}50{{/if}}" th:value="{{{thExpr ../voName "." ccName}}}" th:readonly="${not #strings.isEmpty({{../voName}}.{{ccName}})} ? 'readonly' : null" th:placeholder="{{concat "#{confirm.required." ../entityNameLower "." ccName "}"}}">
                    </div>
                </div>
{{else}}
                <!-- idGeneration='auto' — 자동 채번. 수정 진입 시에만 readonly 로 표시. -->
                <div class="form-group" th:if="${not #strings.isEmpty({{../voName}}.{{ccName}})}">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
                    </div>
                    <div class="form-conts">
                        <input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input" th:value="{{{thExpr ../voName "." ccName}}}" th:readonly="readonly">
                    </div>
                </div>
{{/if}}
{{else}}
{{#if isDate}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
                    </div>
                    <div class="form-conts">
                        <input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input flatpickr-date" placeholder="yyyy-MM-dd" th:value="{{{thExpr ../voName "." ccName " != null ? #dates.format(" ../voName "." ccName ", '" "yyyy-MM-dd" "') : ''"}}}">
                    </div>
                </div>
{{else}}
{{#if (eq javaType "java.lang.String")}}
{{#if fkParent}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
                    </div>
                    <div class="form-conts">
                        <select id="{{ccName}}" name="{{ccName}}" class="krds-form-select">
                            <option value="" th:text="#{search.choose}"></option>
                            <option th:each="c : ${ {{fkParent.entityNameLower}}List }"
                                    th:value="${c.value}"
                                    th:text="${c.label}"
                                    th:selected="{{{thExpr ../voName "." ccName " != null and " ../voName "." ccName " == c.value"}}}"></option>
                        </select>
                    </div>
                </div>
{{else}}
{{#if isYnFlag}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
                    </div>
                    <div class="form-conts">
                        <select id="{{ccName}}" name="{{ccName}}" class="krds-form-select">
                            <option value="Y" th:selected="{{{thExpr ../voName "." ccName " == 'Y'"}}}" th:text="#{input.yes}">Yes</option>
                            <option value="N" th:selected="{{{thExpr ../voName "." ccName " == 'N'"}}}" th:text="#{input.no}">No</option>
                        </select>
                    </div>
                </div>
{{else}}
{{#if isLongText}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"> <span class="required">*</span></label>
                    </div>
                    <div class="form-conts">
                        <textarea id="{{ccName}}" name="{{ccName}}" class="krds-input" rows="6"{{#if maxLength}} maxlength="{{maxLength}}"{{/if}} th:text="{{{thExpr ../voName "." ccName}}}" th:placeholder="{{concat "#{confirm.required." ../entityNameLower "." ccName "}"}}"></textarea>
                    </div>
                </div>
{{else}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"> <span class="required">*</span></label>
                    </div>
                    <div class="form-conts">
                        <input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input" maxlength="{{#if maxLength}}{{maxLength}}{{else}}100{{/if}}" th:value="{{{thExpr ../voName "." ccName}}}" th:placeholder="{{concat "#{confirm.required." ../entityNameLower "." ccName "}"}}">
                    </div>
                </div>
{{/if}}
{{/if}}
{{/if}}
{{else}}
                <div class="form-group">
                    <div class="form-tit">
                        <label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
                    </div>
                    <div class="form-conts">
                        <input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input" th:value="{{{thExpr ../voName "." ccName}}}">
                    </div>
                </div>
{{/if}}
{{/if}}
{{/if}}
{{/each}}
{{#if withAttachment}}
                <!-- 첨부파일 picker + 기존 그룹 목록 (eGov 표준: name="file_1", multiple) -->
                <div class="form-group">
                    <div class="form-tit">
                        <label for="file_1" th:text="#{title.{{entityNameLower}}.attachment}">첨부파일</label>
                    </div>
                    <div class="form-conts">
                        <!-- 기존 첨부파일 목록 (수정 진입 시 Controller 가 model.attachList 로 주입) -->
                        <ul class="attach-list" th:if="${attachList != null and not #lists.isEmpty(attachList)}" style="margin-bottom:8px; padding-left:1.2em; list-style:none;">
                            <li th:each="f : ${attachList}" style="margin-bottom:4px;">
                                <a th:href="@{/cmm/fms/FileDown.do(atchFileId=${f.atchFileId}, fileSn=${f.fileSn})}"
                                   th:text="${f.orignlFileNm}">파일명</a>
                                <span class="file-size" th:text="|(${f.fileMg} bytes)|" style="color:#666; margin-left:4px;"></span>
                                <button type="button" class="krds-btn small danger"
                                        style="margin-left:8px; padding:2px 8px; font-size:0.85em;"
                                        th:attr="data-atch-file-id=${f.atchFileId},data-file-sn=${f.fileSn}"
                                        onclick="{{entityNameLower}}DeleteAttach(this)">삭제</button>
                            </li>
                        </ul>
                        <input type="file" id="file_1" name="file_1" class="krds-input" multiple{{#if maxAttachmentCount}} data-max-count="{{maxAttachmentCount}}"{{/if}}>
                        <p class="info-text" style="color:#666; font-size:0.9em; margin-top:4px;">
                            <span>여러 파일을 한 번에 선택할 수 있습니다 (Cmd/Ctrl 키).</span>
                            <span th:if="${attachList != null and not #lists.isEmpty(attachList)}"
                                  th:text="#{info.{{entityNameLower}}.attachment.existing}">기존 첨부파일이 있습니다. 추가 업로드 시 함께 보관됩니다.</span>
                        </p>
                    </div>
                </div>
{{/if}}
            </div>

	        <div class="page-btn-wrap">
                <div class="btn-wrap">
	                <button type="button" class="krds-btn medium secondary" th:text="#{button.list}" th:onclick="{{entityNameLower}}List()"></button>
	                <button type="button" class="krds-btn medium tertiary" th:text="#{button.reset}" th:onclick="{{entityNameLower}}Reset()"></button>
                </div>
	            <div class="btn-wrap">
					<button type="button"
	                        class="krds-btn medium"
	                        th:text="#{button.modify}"
	                        th:onclick="{{entityNameLower}}Update()"
	                        th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
	                <button type="button"
	                        class="krds-btn medium danger"
	                        th:text="#{button.delete}"
	                        th:onclick="{{entityNameLower}}Delete()"
	                        th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
	                <button type="button"
	                        class="krds-btn medium"
	                        th:text="#{button.create}"
	                        th:onclick="{{entityNameLower}}Add()"
	                        th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
	            </div>
	        </div>
		</div>

	</form>

</div>

</body>
</html>
