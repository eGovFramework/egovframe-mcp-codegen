{{#if withAttachment}}

	/**
	 * 첨부파일 협력 객체. @RequiredArgsConstructor 는 final 필드만 생성자에 포함하므로
	 * 빈 이름이 정해진 이 둘은 non-final 필드 주입(@Resource)으로 받는다.
	 */
	@Resource(name = "EgovFileMngService")
	private EgovFileMngService fileMngService;

	@Resource(name = "EgovFileMngUtil")
	private EgovFileMngUtil fileUtil;
{{/if}}

{{#if hasDateAttr}}
	/**
	 * 폼 입력을 java.sql.Date / java.sql.Timestamp 로 바인딩한다.
	 * - Date: 'yyyy-MM-dd' 만 허용. 빈 문자열은 null.
	 * - Timestamp: 'yyyy-MM-dd' 만 들어오면 ' 00:00:00' 보강 후 Timestamp.valueOf().
	 */
	@InitBinder
	public void initBinder(WebDataBinder binder) {
		binder.registerCustomEditor(Date.class, new PropertyEditorSupport() {
			@Override
			public void setAsText(String text) throws IllegalArgumentException {
				if (text == null || text.trim().isEmpty()) { setValue(null); return; }
				setValue(Date.valueOf(text.trim()));
			}
		});
		binder.registerCustomEditor(Timestamp.class, new PropertyEditorSupport() {
			@Override
			public void setAsText(String text) throws IllegalArgumentException {
				if (text == null || text.trim().isEmpty()) { setValue(null); return; }
				String s = text.trim();
				if (s.length() == 10 && s.charAt(4) == '-' && s.charAt(7) == '-') s = s + " 00:00:00";
				setValue(Timestamp.valueOf(s));
			}
		});
	}

{{/if}}
{{#if isPrimaryEntity}}
	@GetMapping("/")
	public String search(@ModelAttribute {{entityName}}VO {{entityNameLower}}VO, Model model) throws Exception {
		return this.list({{entityNameLower}}VO, model);
