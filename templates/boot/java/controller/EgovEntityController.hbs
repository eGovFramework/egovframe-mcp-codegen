	/**
	 * 첨부 그룹의 단일 파일(atchFileId + fileSn) 1건 삭제.
	 * 도메인 행은 유지하고 첨부 한 건만 떼어내는 용도 — 수정 화면에서 호출.
	 * 반환: 단순 텍스트 "ok" (성공).
	 */
	@PostMapping("/{{entityNameLower}}/deleteAttachFile")
	@ResponseBody
	public String deleteAttachFile(
			@RequestParam("atchFileId") String atchFileId,
			@RequestParam("fileSn") String fileSn) throws Exception {
		FileVO fvo = new FileVO();
		fvo.setAtchFileId(atchFileId);
		fvo.setFileSn(fileSn);
		this.fileMngService.deleteFileInf(fvo);
		return "ok";
	}
