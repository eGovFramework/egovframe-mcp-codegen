	@PostMapping("/{{entityNameLower}}/list")
	public String list(@ModelAttribute {{entityName}}VO {{entityNameLower}}VO, Model model) throws Exception {
		{{entityNameLower}}VO.setPageUnit(propertiesService.getInt("pageUnit"));
		{{entityNameLower}}VO.setPageSize(propertiesService.getInt("pageSize"));
		PaginationInfo paginationInfo = new PaginationInfo();
		paginationInfo.setCurrentPageNo({{entityNameLower}}VO.getPageIndex());
		paginationInfo.setRecordCountPerPage({{entityNameLower}}VO.getPageUnit());
		paginationInfo.setPageSize({{entityNameLower}}VO.getPageSize());
		{{entityNameLower}}VO.setFirstIndex(paginationInfo.getFirstRecordIndex());
		{{entityNameLower}}VO.setLastIndex(paginationInfo.getLastRecordIndex());
		{{entityNameLower}}VO.setRecordCountPerPage(paginationInfo.getRecordCountPerPage());
		model.addAttribute("resultList", {{entityNameLower}}Service.select{{entityName}}List({{entityNameLower}}VO));
		paginationInfo.setTotalRecordCount({{entityNameLower}}Service.select{{entityName}}ListTotCnt({{entityNameLower}}VO));
		model.addAttribute("paginationInfo", paginationInfo);
		return "egov{{entityName}}List";
	}

	@PostMapping("/{{entityNameLower}}/detail")
	public String detail(@ModelAttribute {{entityName}}VO {{entityNameLower}}VO, @RequestParam String {{pkAttributes.0.ccName}}, Model model) throws Exception {
		{{entityNameLower}}VO.set{{pkAttributes.0.pcName}}({{pkAttributes.0.ccName}});
		{{entityName}}VO detail = this.{{entityNameLower}}Service.select{{entityName}}({{entityNameLower}}VO);
		model.addAttribute("{{entityNameLower}}VO", detail);
{{#if hasFk}}
		populate{{entityName}}ReferenceLists(model);
{{/if}}
{{#if withAttachment}}
		// 기존 첨부파일 목록을 model 에 주입 — Register 화면에서 다운로드 링크로 렌더된다.
		// 첨부 그룹 키는 CHAR(20) 이라 빈 값이 공백으로 읽힐 수 있어 trim 후 비어 있는지 검사한다.
		String existing{{attachmentFieldNamePascal}} = detail.get{{attachmentFieldNamePascal}}();
		if (existing{{attachmentFieldNamePascal}} != null && !existing{{attachmentFieldNamePascal}}.trim().isEmpty()) {
			FileVO attachKey = new FileVO();
			attachKey.setAtchFileId(existing{{attachmentFieldNamePascal}});
			model.addAttribute("attachList", this.fileMngService.selectFileInfs(attachKey));
		}
{{/if}}
		return "egov{{entityName}}Register";
	}

	@GetMapping("/{{entityNameLower}}/add")
	public String form(@ModelAttribute {{entityName}}VO {{entityNameLower}}VO{{#if hasFk}}, Model model{{/if}}) {
{{#if hasFk}}
		populate{{entityName}}ReferenceLists(model);
{{/if}}
		return "egov{{entityName}}Register";
	}

	@PostMapping("/{{entityNameLower}}/add")
	public String add({{#if withAttachment}}final MultipartHttpServletRequest multiRequest, {{/if}}@Valid @ModelAttribute {{entityName}}VO {{entityNameLower}}VO, BindingResult bindingResult{{#if hasFk}}, Model model{{/if}}) throws Exception {
		if (bindingResult.hasErrors()) {
{{#if hasFk}}
			populate{{entityName}}ReferenceLists(model);
{{/if}}
			return "egov{{entityName}}Register";
		}
{{#if withAttachment}}
		// 첨부파일 처리 — 디스크에 저장한 뒤 insertFileInfs 로 그룹 키를 채번/INSERT 하고,
		// 반환된 키만 도메인 VO 에 세팅한다 (요청에 실려 온 값은 덮어쓴다).
		String {{attachmentFieldName}} = "";
		final java.util.List<MultipartFile> files = multiRequest.getFiles("file_1");
		if (files != null && !files.isEmpty()) {
			java.util.List<FileVO> fvoList = this.fileUtil.parseFileInf(files, "{{entityNameUpper}}_", 0, "", "");
			{{attachmentFieldName}} = this.fileMngService.insertFileInfs(fvoList);
		}
		{{entityNameLower}}VO.set{{attachmentFieldNamePascal}}({{attachmentFieldName}});
{{/if}}
		this.{{entityNameLower}}Service.insert{{entityName}}({{entityNameLower}}VO);
		return "redirect:/egov{{entityName}}List.do";
	}

	@PostMapping("/{{entityNameLower}}/update")
	public String update({{#if withAttachment}}final MultipartHttpServletRequest multiRequest, {{/if}}@Valid @ModelAttribute {{entityName}}VO {{entityNameLower}}VO, BindingResult bindingResult{{#if hasFk}}, Model model{{/if}}) throws Exception {
		if (bindingResult.hasErrors()) {
{{#if hasFk}}
			populate{{entityName}}ReferenceLists(model);
{{/if}}
			return "egov{{entityName}}Register";
		}
{{#if withAttachment}}
		// 첨부파일 update — 신규 그룹이면 채번, 기존 그룹이면 다음 FILE_SN 부터 append.
		// 그룹 키는 요청 값을 신뢰하지 않고 DB 에 저장된 값에서 읽는다 (다른 레코드의 첨부 그룹 탈취 방지).
		{{entityName}}VO stored = this.{{entityNameLower}}Service.select{{entityName}}({{entityNameLower}}VO);
		String {{attachmentFieldName}} = stored.get{{attachmentFieldNamePascal}}();
		final java.util.List<MultipartFile> files = multiRequest.getFiles("file_1");
		if (files != null && !files.isEmpty()) {
			// CHAR(20) 컬럼은 빈 값이 공백으로 채워져 읽히므로 trim 후 비어 있는지 검사한다.
			if ({{attachmentFieldName}} == null || {{attachmentFieldName}}.trim().isEmpty()) {
				// (A) 첨부 그룹이 아직 없음 → 신규 채번
				java.util.List<FileVO> fvoList = this.fileUtil.parseFileInf(files, "{{entityNameUpper}}_", 0, "", "");
				{{attachmentFieldName}} = this.fileMngService.insertFileInfs(fvoList);
			} else {
				// (B) 기존 그룹에 추가 — getMaxFileSN 으로 다음 FILE_SN 부터 (중복 PK 방지)
				FileVO key = new FileVO();
				key.setAtchFileId({{attachmentFieldName}});
				int cnt = this.fileMngService.getMaxFileSN(key);
				java.util.List<FileVO> fvoList = this.fileUtil.parseFileInf(files, "{{entityNameUpper}}_", cnt, {{attachmentFieldName}}, "");
				this.fileMngService.updateFileInfs(fvoList);
			}
		}
		// 요청에 실려 온 값을 덮어써 DB 값(또는 새로 채번한 값)만 저장한다.
		{{entityNameLower}}VO.set{{attachmentFieldNamePascal}}({{attachmentFieldName}});
{{/if}}
		this.{{entityNameLower}}Service.update{{entityName}}({{entityNameLower}}VO);
		return "redirect:/egov{{entityName}}List.do";
	}
{{#if hasFk}}

	/** FK lookup 콤보 리스트들을 모델에 주입한다 (Register 화면에서 select 옵션 소스). */
	private void populate{{entityName}}ReferenceLists(Model model) {
{{#each uniqueFkParents}}
		model.addAttribute("{{fkParent.entityNameLower}}List", {{../entityNameLower}}Service.select{{fkParent.entityName}}ComboList());
{{/each}}
	}
{{/if}}

