<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<title th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="|{{entityName}} #{button.modify}|"></title>
	<title th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="|{{entityName}} #{button.create}|"></title>

	<link rel="stylesheet" type="text/css" th:href="@{/css/component/output.css}">
	<link rel="stylesheet" type="text/css" th:href="@{/css/egovframe.css}">
{{#if hasDateAttr}}
	<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
{{/if}}
	<!-- common.js 가 이 홀더에서 contextPath 를 읽는다 (4.3 Boot 는 server.servlet.context-path 가 있을 수 있다). -->
	<link id="contextPathHolder" th:data-contextPath="${#httpServletRequest.getContextPath()}"/>
	<script th:inline="javascript" th:src="@{/js/jquery.min.js}"></script>
	<script th:inline="javascript" th:src="@{/js/component/ui-script.js}" defer></script>
	<script th:inline="javascript" th:src="@{/js/egovframework/common.js}" defer></script>
{{#if hasDateAttr}}
	<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/ko.js"></script>
{{/if}}

	<script th:inline="javascript">
		// 폼에 action 이 없어 Enter 로 제출되면 POST 전용 URL 에 GET 이 가서 405 가 난다 — Enter 제출을 막는다.
		document.addEventListener('keydown', function(event) { if (event.keyCode === 13) { event.preventDefault(); }; }, true);
{{#if hasDateAttr}}

		document.addEventListener('DOMContentLoaded', function() {
			if (typeof flatpickr === 'function') {
				flatpickr('.flatpickr-date', {
					dateFormat: 'Y-m-d',
					allowInput: true,
					locale: (typeof flatpickr.l10ns !== 'undefined' && flatpickr.l10ns.ko) ? 'ko' : 'default'
				});
			}
		});
{{/if}}

		function {{entityNameLower}}List() { $(location).attr('href', contextPath + '/egov{{entityName}}List.do'); }
		function {{entityNameLower}}Add() { if (confirm([[#{add.confirm}]])) { $('#detailForm').attr('method', 'post').attr('action', contextPath + '/{{entityNameLower}}/add').submit(); } }
		function {{entityNameLower}}Update() { if (confirm([[#{modify.confirm}]])) { $('#detailForm').attr('method', 'post').attr('action', contextPath + '/{{entityNameLower}}/update').submit(); } }
		function {{entityNameLower}}Delete() { if (confirm([[#{delete.confirm}]])) { $('#detailForm').attr('method', 'post').attr('action', contextPath + '/{{entityNameLower}}/delete').submit(); } }
		function {{entityNameLower}}Reset() { $('form').each(function() { this.reset(); }); }
{{#if withAttachment}}

		/** 첨부 그룹의 단일 파일을 삭제한다. 도메인 행은 유지하고, 성공하면 해당 li 만 화면에서 제거한다. */
		function {{entityNameLower}}DeleteAttach(btn) {
			if (!confirm([[#{delete.confirm}]])) { return; }
			var $btn = $(btn);
			$.ajax({
				url: contextPath + '/{{entityNameLower}}/deleteAttachFile',
				type: 'POST',
				data: { atchFileId: $btn.attr('data-atch-file-id'), fileSn: $btn.attr('data-file-sn') }
			}).done(function() {
				$btn.closest('li').remove();
			}).fail(function(xhr) {
				alert('Attachment delete failed (status=' + xhr.status + ').');
			});
		}
{{/if}}
	</script>
</head>

<body>
<div id="container" class="inner">

	<h2 class="heading-large">
		<span th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="#{button.modify}"></span>
		<span th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}" th:text="#{button.create}"></span>
	</h2>

	<form id="detailForm" name="detailForm" th:object="{{{thExpr voName}}}"{{#if withAttachment}} enctype="multipart/form-data"{{/if}}>

		<div class="conts-wrap">
			<div class="fieldset input-form">
{{#each attributes}}
{{#if isPrimaryKey}}
				<!-- PK 는 수정 진입 시(값 존재)에만 readonly 로 보인다. -->
				<div class="form-group" th:if="{{{thExpr ../voName "." ccName}}} != null">
					<div class="form-tit">
						<label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
					</div>
					<div class="form-conts">
						<input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input" th:value="{{{thExpr ../voName "." ccName}}}" maxlength="{{#if maxLength}}{{maxLength}}{{else}}10{{/if}}" readonly="readonly"/>
					</div>
				</div>
{{else}}
{{#if isDate}}
				<!-- 날짜: flatpickr 달력. 표시·전송 모두 yyyy-MM-dd (컨트롤러 @InitBinder 가 Timestamp 에 00:00:00 을 보강). -->
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
					</div>
					<div class="form-conts">
						<input type="text" id="{{ccName}}" name="{{ccName}}" class="krds-input flatpickr-date" placeholder="yyyy-MM-dd" th:value="{{{thExpr ../voName "." ccName " != null ? #dates.format(" ../voName "." ccName ", '" "yyyy-MM-dd" "') : ''"}}}">
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{else}}
{{#if (eq javaType "java.lang.String")}}
{{#if fkParent}}
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
					</div>
					<div class="form-conts">
						<select id="{{ccName}}" name="{{ccName}}" th:field="{{concat "*{" ccName "}"}}" class="krds-form-select">
							<option value="" th:text="#{search.choose}"></option>
							<option th:each="c : ${ {{fkParent.entityNameLower}}List }"
									th:value="${c.value}"
									th:text="${c.label}"
									th:selected="{{{thExpr ../voName "." ccName " != null and " ../voName "." ccName " == c.value"}}}"></option>
						</select>
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{else}}
{{#if isYnFlag}}
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
					</div>
					<div class="form-conts">
						<select id="{{ccName}}" name="{{ccName}}" th:field="{{concat "*{" ccName "}"}}" class="krds-form-select">
							<option value="Y" th:text="#{input.yes}">Yes</option>
							<option value="N" th:text="#{input.no}">No</option>
						</select>
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{else}}
{{#if isLongText}}
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}"><span th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></span>{{#if isNotNull}} <span class="required">*</span>{{/if}}</label>
					</div>
					<div class="form-conts">
						<textarea id="{{ccName}}" name="{{ccName}}" th:field="{{concat "*{" ccName "}"}}" class="krds-input" rows="6"{{#if maxLength}} maxlength="{{maxLength}}"{{/if}} th:text="{{{thExpr ../voName "." ccName}}}"></textarea>
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{else}}
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}"><span th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></span>{{#if isNotNull}} <span class="required">*</span>{{/if}}</label>
					</div>
					<div class="form-conts">
						<input type="text" id="{{ccName}}" name="{{ccName}}" th:field="{{concat "*{" ccName "}"}}" class="krds-input" th:value="{{{thExpr ../voName "." ccName}}}" maxlength="{{#if maxLength}}{{maxLength}}{{else}}100{{/if}}"/>
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{/if}}
{{/if}}
{{/if}}
{{else}}
				<div class="form-group">
					<div class="form-tit">
						<label for="{{ccName}}" th:text="{{concat "#{title." ../entityNameLower "." ccName "}"}}"></label>
					</div>
					<div class="form-conts">
						<input type="text" id="{{ccName}}" name="{{ccName}}" th:field="{{concat "*{" ccName "}"}}" class="krds-input" th:value="{{{thExpr ../voName "." ccName}}}"/>
						<p class="form-hint-invalid" th:if="${#fields.hasErrors('{{ccName}}')}" th:errors="{{concat "*{" ccName "}"}}"></p>
					</div>
				</div>
{{/if}}
{{/if}}
{{/if}}
{{/each}}
{{#if withAttachment}}
				<!-- 첨부파일 picker + 기존 그룹 목록 (eGov 표준: name="file_1", multiple) -->
				<div class="form-group">
					<div class="form-tit">
						<label for="file_1" th:text="#{title.{{entityNameLower}}.attachment}">첨부파일</label>
					</div>
					<div class="form-conts">
						<!-- 기존 첨부파일 목록 (수정 진입 시 Controller 가 model.attachList 로 주입) -->
						<ul class="attach-list" th:if="${attachList != null and not #lists.isEmpty(attachList)}" style="margin-bottom:8px; padding-left:1.2em; list-style:none;">
							<li th:each="f : ${attachList}" style="margin-bottom:4px;">
								<a th:href="@{/cmm/fms/FileDown.do(atchFileId=${f.atchFileId}, fileSn=${f.fileSn})}"
								   th:text="${f.orignlFileNm}">파일명</a>
								<span class="file-size" th:text="|(${f.fileMg} bytes)|" style="color:#666; margin-left:4px;"></span>
								<button type="button" class="krds-btn small danger"
										style="margin-left:8px; padding:2px 8px; font-size:0.85em;"
										th:attr="data-atch-file-id=${f.atchFileId},data-file-sn=${f.fileSn}"
										th:text="#{button.delete}"
										onclick="{{entityNameLower}}DeleteAttach(this)"></button>
							</li>
						</ul>
						<input type="file" id="file_1" name="file_1" class="krds-input" multiple{{#if maxAttachmentCount}} data-max-count="{{maxAttachmentCount}}"{{/if}}>
						<p class="info-text" style="color:#666; font-size:0.9em; margin-top:4px;"
						   th:if="${attachList != null and not #lists.isEmpty(attachList)}"
						   th:text="#{info.{{entityNameLower}}.attachment.existing}"></p>
					</div>
				</div>
{{/if}}
			</div>

			<div class="page-btn-wrap">
				<div class="btn-wrap">
					<button type="button" class="krds-btn medium secondary" th:text="#{button.list}" th:onclick="{{entityNameLower}}List()"></button>
					<button type="button" class="krds-btn medium tertiary" th:text="#{button.reset}" th:onclick="{{entityNameLower}}Reset()"></button>
				</div>
				<div class="btn-wrap">
					<button type="button"
							class="krds-btn medium"
							th:text="#{button.modify}"
							th:onclick="{{entityNameLower}}Update()"
							th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
					<button type="button"
							class="krds-btn medium danger"
							th:text="#{button.delete}"
							th:onclick="{{entityNameLower}}Delete()"
							th:if="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
					<button type="button"
							class="krds-btn medium"
							th:text="#{button.create}"
							th:onclick="{{entityNameLower}}Add()"
							th:unless="${not #strings.isEmpty({{voName}}.{{pkAttributes.0.ccName}})}"></button>
				</div>
			</div>
		</div>

	</form>

</div>

</body>
</html>
